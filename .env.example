# Senha de acesso ao Painel dos Noivos (/painel)
ADMIN_PASSWORD=troque-esta-senha

# Chave PIX exibida na lista de presentes
NEXT_PUBLIC_PIX_KEY=presentes@isaerudinei.com.br

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: só no servidor. Nunca use em componentes "use client".
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe (Developers > API keys). Use as chaves de TESTE até o site ir ao ar.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Assinatura do webhook: vem do "stripe listen" (local) ou do Dashboard (produção)
STRIPE_WEBHOOK_SECRET=whsec_...

# Endereço público do site (usado nos links de retorno do pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
